# Keep local development aligned with backend/go.mod.
FROM golang:1.25.4-alpine

# Install necessary tools and CA utilities.
# The 'ca-certificates' package is required for the Go application to trust the
# mounted Keycloak certificate over HTTPS connections.
RUN apk add --no-cache git bash ca-certificates

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum first (for caching dependencies)
COPY go.mod go.sum ./
RUN go mod download

# Copy all source code
COPY . .

# Expose backend port
EXPOSE 9000

# Use environment file if exists
ENV $(cat app.env | xargs)
# Start backend in dev mode
CMD ["sh", "-c", "go run ./cmd/server"]
