# Keep local development aligned with backend/go.mod.
FROM golang:1.25.4-alpine AS builder

# Install necessary tools and CA utilities.
# The 'ca-certificates' package is required for the Go application to trust the
# mounted Keycloak certificate over HTTPS connections.
RUN apk add --no-cache git bash ca-certificates

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum first (for caching dependencies)
COPY go.mod go.sum ./
RUN go mod download

# Copy all source code
COPY . .

RUN go build -o /tmp/sso-server ./cmd/server

# Runtime image used by local Kubernetes. Running a prebuilt binary avoids
# compiling with `go run` inside the pod, which can exceed local memory limits.
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /tmp/sso-server ./sso-server
COPY --from=builder /app/internal/db/migrations ./internal/db/migrations
COPY --from=builder /app/config ./config

RUN mkdir -p /data/uploads

# Expose backend port
EXPOSE 9000

CMD ["./sso-server"]
