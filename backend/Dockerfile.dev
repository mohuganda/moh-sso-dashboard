# Keep local development aligned with backend/go.mod.
FROM golang:1.25.4-alpine

RUN apk add --no-cache git bash ca-certificates tzdata

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# Air is used only in the compose development image for hot reload.
RUN go install github.com/air-verse/air@latest

COPY . .

RUN mkdir -p /data/uploads tmp

EXPOSE 9000

CMD ["air", "-c", ".air.toml"]
