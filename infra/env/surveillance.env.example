# Standalone local surveillance PostgreSQL. Keep the real file outside Git.
SURVEILLANCE_DB_HOST=127.0.0.1
SURVEILLANCE_DB_PORT=55434
SURVEILLANCE_DB_LOCAL_PORT=55434
SURVEILLANCE_DB_USER=surveillance
SURVEILLANCE_DB_NAME=surveillance
SURVEILLANCE_DB_PASSWORD=replace-with-a-local-secret
SURVEILLANCE_DB_ENABLE_SSL=false
# A backend running inside Docker needs a reachable container hostname/network,
# not 127.0.0.1. Never copy localhost into the production backend configuration.
