# Local Observatory PostgreSQL in the main development stack. Keep the real file outside Git.
OBSERVATORY_DB_HOST=127.0.0.1
OBSERVATORY_DB_PORT=55434
OBSERVATORY_DB_LOCAL_PORT=55434
OBSERVATORY_DB_USER=surveillance
OBSERVATORY_DB_NAME=observatory
OBSERVATORY_DB_PASSWORD=replace-with-a-local-secret
OBSERVATORY_DB_ENABLE_SSL=false
# A backend running inside Docker needs a reachable container hostname/network,
# not 127.0.0.1. Never copy localhost into the production backend configuration.
