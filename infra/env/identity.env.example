# Optional separate-instance stack; use identity-shared.env.example for an existing instance.
# Copy to a private file outside source control. Use a unique project, port and
# generated realm per separate stack.
IDENTITY_PROJECT=moh-identity-staging
IDENTITY_HOSTNAME=https://auth-staging.example.org
IDENTITY_PORT=8181
IDENTITY_REALM_FILE=/absolute/private/path/moh-staging.json
IDENTITY_ADMIN_USERNAME=identity-admin
IDENTITY_ADMIN_PASSWORD=
IDENTITY_DB_PASSWORD=
IDENTITY_PROXY_HEADERS=xforwarded
KEYCLOAK_VERSION=26.0.5
