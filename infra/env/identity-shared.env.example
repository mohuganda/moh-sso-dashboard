# Operator-only environment for bootstrap-keycloak-realms.py.
# Keep the populated copy private and outside the repository and portal containers.
KEYCLOAK_BASE_URL=https://auth.health.go.ug
# Preferred: existing administrative client in master with realm create/read access.
KEYCLOAK_BOOTSTRAP_CLIENT_ID=
KEYCLOAK_BOOTSTRAP_CLIENT_SECRET=
# Alternative: existing master administrator (admin-cli); use only one auth mode.
KEYCLOAK_BOOTSTRAP_USERNAME=
KEYCLOAK_BOOTSTRAP_PASSWORD=
