# ==================================================
# Global
# ==================================================
ENVIRONMENT=development
GIN_MODE=debug

# ==================================================
# Frontend
# ==================================================
FRONTEND_BASE_URL=http://localhost:3000

# ==================================================
# Keycloak (Infrastructure)
# ==================================================
KEYCLOAK_VERSION=26.0.5

KEYCLOAK_DB=postgres
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Used by Keycloak container itself
KEYCLOAK_HOSTNAME=http://localhost:8081

# ==================================================
# Keycloak (Application / Backend usage)
# ==================================================

KEYCLOAK_EXTERNAL_URL=http://localhost:8081

LOGIN_URL=http://localhost:9000/api/v1/auth/login

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=moh-realm

# 🔐 Backend automation (client_credentials)
KEYCLOAK_ADMIN_CLIENT_ID=dashboard-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dashboard-admin-secret

# 🌍 Web login (authorization_code)
KEYCLOAK_WEB_CLIENT_ID=dashboard-web
KEYCLOAK_WEB_CLIENT_SECRET=dashboard-web-secret
KEYCLOAK_REDIRECT_URI=http://localhost:9000/api/v1/auth/callback

# ==================================================
# Backend (Go / Gin)
# ==================================================
SERVER_PORT=9000

# ==================================================
# Backend Database
# ==================================================
DB_DRIVER=postgres
DB_HOST=backend-db
DB_PORT=5432
DB_NAME=sso_dashboard
DB_USER=postgres
DB_PASSWORD=postgres
DB_ENABLE_SSL=false

# ==================================================
# Redis
# ==================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================================
# JWT / Auth (APP-SPECIFIC, NOT Keycloak)
# ==================================================
TOKEN_SYMMETRIC_KEY=supersecretkey12345678901234567890
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

# ==================================================
# TLS (Disabled for Development)
# ==================================================
ENABLE_TLS=false
TLS_CERT=/app/certs/server.crt
TLS_KEY=/app/certs/server.key
TLS_KEYCLOAK_CA_CERT_PATH=/usr/local/share/ca-certificates/keycloak.crt


# ==================================================
# Upload Management
# ==================================================
REMOTE_DB_HOST=10.0.0.15
REMOTE_DB_PORT=5432
REMOTE_DB_USER=abila
REMOTE_DB_PASSWORD=***


# ==================================================
# Storage Management
# ==================================================
STORAGE_PROVIDER=local
LOCAL_BASE_PATH=/data/uploads