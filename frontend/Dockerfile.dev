# Use Node.js 20 Alpine as base
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install dependencies
COPY . .
RUN npm install

# Expose shell and local microfrontend dev server ports
EXPOSE 3000
EXPOSE 4101 4102 4103 4104 4105 4106 4107 4108 4109 4110 4111 4112 4114

# Start dev server. Override FRONTEND_DEV_COMMAND to run remote microfrontend mode,
# for example: npm run dev:remote:all
CMD ["sh", "-c", "${FRONTEND_DEV_COMMAND:-npm run dev:shell}"]
