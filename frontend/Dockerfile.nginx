# ======================
# Stage 1: Build
# ======================
FROM node:20-alpine AS build

WORKDIR /app
ENV FRONTEND_ASSET_BASE_URL=/
ENV FRONTEND_BASE_PATH=/

# Install ALL deps (including workspace dev deps)
COPY . .
RUN npm ci
RUN node scripts/use-runtime-config.mjs production

# Build shell, packages, and standalone microfrontend bundles
RUN npm run build:docker

# ======================
# Stage 2: Production (Nginx)
# ======================
FROM nginx:1.27-alpine

# Remove default nginx website
RUN rm -rf /usr/share/nginx/html/*

# Copy build output
COPY --from=build /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
