{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/shell/src/*"],
      "@/features/announcements/*": ["apps/announcements/src/*"],
      "@/features/audit/*": ["apps/audit/src/*"],
      "@/features/clients/*": ["apps/clients/src/*"],
      "@/features/data-visualizer/*": ["apps/data-visualizer/src/*"],
      "@/features/documents/*": ["apps/documents/src/*"],
      "@/features/e-services/*": ["apps/e-services/src/*"],
      "@/features/email/*": ["apps/email/src/*"],
      "@/features/issue-tracker/*": ["apps/issue-tracker/src/*"],
      "@/features/report-browser/*": ["apps/report-browser/src/*"],
      "@/features/surveillance/*": ["apps/surveillance/src/*"],
      "@/features/users/*": ["apps/users/src/*"],
      "@/features/utilities/*": ["apps/utilities/src/*"],
      "@/store/api/*": ["packages/api/src/api/*"],
      "@/store/auth/*": ["packages/auth/src/auth/*"],
      "@/store/types/*": ["packages/types/src/types/*"],
      "@/store/ui/*": ["packages/state/src/ui/*"],
      "@/store/clients/*": ["packages/state/src/clients/*"],
      "@/store/document/*": ["packages/state/src/document/*"],
      "@/store": ["packages/state/src/index.ts"],
      "@/shared/*": ["packages/ui/src/shared/*"],
      "@/config/*": ["packages/config/src/*"],
      "@/lib/*": ["packages/config/src/lib/*"],
      "@/ui/*": ["packages/ui/src/ui/*"],
      "@/utils/*": ["packages/utils/src/utils/*"],
      "@/types/*": ["packages/types/src/global/*"],
      "@moh-sso/api": ["packages/api/src/index.ts"],
      "@moh-sso/auth": ["packages/auth/src/index.ts"],
      "@moh-sso/config": ["packages/config/src/index.ts"],
      "@moh-sso/microfrontend": ["packages/microfrontend/src/index.ts"],
      "@moh-sso/state": ["packages/state/src/index.ts"],
      "@moh-sso/types": ["packages/types/src/index.ts"],
      "@moh-sso/ui": ["packages/ui/src/index.ts"],
      "@moh-sso/utils": ["packages/utils/src/index.ts"],
      "@moh-sso/announcements/single-spa": ["apps/announcements/src/single-spa.tsx"],
      "@moh-sso/audit/single-spa": ["apps/audit/src/single-spa.tsx"],
      "@moh-sso/clients/single-spa": ["apps/clients/src/single-spa.tsx"],
      "@moh-sso/data-visualizer/single-spa": ["apps/data-visualizer/src/single-spa.tsx"],
      "@moh-sso/documents/single-spa": ["apps/documents/src/single-spa.tsx"],
      "@moh-sso/e-services/single-spa": ["apps/e-services/src/single-spa.tsx"],
      "@moh-sso/email/single-spa": ["apps/email/src/single-spa.tsx"],
      "@moh-sso/issue-tracker/single-spa": ["apps/issue-tracker/src/single-spa.tsx"],
      "@moh-sso/report-browser/single-spa": ["apps/report-browser/src/single-spa.tsx"],
      "@moh-sso/surveillance/single-spa": ["apps/surveillance/src/single-spa.tsx"],
      "@moh-sso/users/single-spa": ["apps/users/src/single-spa.tsx"],
      "@moh-sso/utilities/single-spa": ["apps/utilities/src/single-spa.tsx"],
      "@moh-sso/*": ["apps/*/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowSyntheticDefaultImports": true
  }
}
