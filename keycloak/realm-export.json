{
  "realm": "moh-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 1800,
  "clientScopes": [
    {
      "name": "openid",
      "protocol": "openid-connect"
    },
    {
      "name": "health-context",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "district-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "district",
            "claim.name": "district",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "facility-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "facility",
            "claim.name": "facility",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "full_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "user_id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-property-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "id",
        "claim.name": "user_id",
        "jsonType.label": "String",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role with full access"
      },
      {
        "name": "manager",
        "description": "Can manage some applications"
      },
      {
        "name": "user",
        "description": "Standard user role"
      }
    ],
    "client": {
      "dashboard-web": [
        {
          "name": "dashboard-web_access",
          "description": "Access MOH Dashboard"
        },
        {
          "name": "integrated-outbreak-system_access",
          "description": "Can open IOS from the dashboard"
        }
      ],
      "integrated-outbreak-system": [
        {
          "name": "integrated-outbreak-system_access",
          "description": "Base access to Integrated Outbreak System"
        },
        {
          "name": "super_admin",
          "description": "Super Administrator with full system access"
        },
        {
          "name": "admin",
          "description": "Administrator with management access"
        },
        {
          "name": "manager",
          "description": "Department manager with oversight access"
        },
        {
          "name": "viewer",
          "description": "Read-only access to reports and data"
        },
        {
          "name": "data_entry",
          "description": "Data entry personnel"
        },
        {
          "name": "lab_technician",
          "description": "Laboratory technician with lab-specific access"
        },
        {
          "name": "surveillance_officer",
          "description": "Surveillance officer with monitoring access"
        }
      ],
      "report-browser": [
        {
          "name": "report-browser_access",
          "description": "Access MOH Report browser"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "dashboard-admin",
      "name": "MOH Dashboard Admin Client",
      "description": "MOH Dashboard Admin Client",
      "enabled": true,
      "secret": "dashboard-admin-secret",
      "publicClient": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "integrated-outbreak-system-admin",
      "name": "Integrated Outbreak System Admin Client",
      "description": "Admin client for managing Integrated Outbreak System",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ios-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "dashboard-web",
      "name": "MOH SSO Dashboard Web",
      "description": "MOH SSO Dashboard Web",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "enabled": true,
      "secret": "dashboard-web-secret",
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:9000/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "attributes": {
        "access.token.lifespan": "1800",
        "ui.icon": "reporting",
        "ui.home": "/dashboard"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dashboard-web",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "report-browser",
      "name": "Report Browser",
      "description": "Report Browser Dashboard",
      "rootUrl": "https://dashboards.health.go.ug/report-browser/",
      "baseUrl": "https://dashboards.health.go.ug/report-browser/",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "report-browser-secret",
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/auth/callback"
      ],
      "webOrigins": [
        "https://dashboards.health.go.ug/report-browser/"
      ],
      "attributes": {
        "access.token.lifespan": "1800",
        "ui.icon": "reporting",
        "ui.home": "/dashboard"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "integrated-outbreak-system",
      "name": "IOS",
      "description": "Integrated Outbreak System Backend API",
      "rootUrl": "http://localhost:3001",
      "baseUrl": "http://localhost:3001",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "ios-secret",
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "access.token.lifespan": "1800",
        "ui.icon": "user",
        "ui.home": "/dashboard"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ]
    }
  ],
